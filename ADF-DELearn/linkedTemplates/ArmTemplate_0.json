					{
						"name": "price_nightly",
						"type": "decimal",
						"precision": 12,
						"scale": 2
					},
					{
						"name": "cleaning_fee",
						"type": "decimal",
						"precision": 12,
						"scale": 2
					},
					{
						"name": "total_amount",
						"type": "decimal",
						"precision": 14,
						"scale": 2
					},
					{
						"name": "currency",
						"type": "nvarchar"
					},
					{
						"name": "country_code",
						"type": "nvarchar"
					},
					{
						"name": "city",
						"type": "nvarchar"
					},
					{
						"name": "channel",
						"type": "nvarchar"
					},
					{
						"name": "device_type",
						"type": "nvarchar"
					},
